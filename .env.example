# Docker
APP_PORT=8080

# LLM，可为空
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# RAG
RAG_MIN_RELEVANCE_SCORE=0.35
MAX_UPLOAD_BYTES=10485760

# Optional Reranker，默认关闭
RAG_RERANKER_ENABLED=false
RAG_RERANKER_MODEL=
RAG_RERANKER_CANDIDATE_TOP_K=15

# Storage backend
# memory（默认）: 现有 JSON 元数据 + 内存 NumPy 索引，不连接数据库
# pgvector      : 后续 PR 接入，届时必须提供有效的 DATABASE_URL
VECTOR_STORE_BACKEND=memory

# PostgreSQL / pgvector local development
# 这些是本地开发默认值，生产环境必须替换密码；.env 绝不能提交到 Git。
# 默认 memory 模式不会使用 DATABASE_URL。
POSTGRES_DB=course_rag
POSTGRES_USER=course_rag
POSTGRES_PASSWORD=course_rag
DATABASE_URL=postgresql+psycopg://course_rag:course_rag@db:5432/course_rag
