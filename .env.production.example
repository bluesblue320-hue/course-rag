# Production environment for course-rag single-host deployment.
#
# Usage:
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#   # edit the values below, then:
#   docker compose \
#     --env-file .env.production \
#     -f compose.yaml \
#     -f compose.pgvector.yaml \
#     -f compose.prod.yaml \
#     up -d --build
#
# This file is for PRODUCTION only.  Local development keeps using
# .env.example / .env and `docker compose up`.  Never commit
# .env.production; it is ignored by Git and never copied into images.

# Public domain served by Caddy over HTTPS.  Must point (A/AAAA record) at
# this VPS before the first start so the ACME certificate can be issued.
# Required by the production Compose stack.
DOMAIN=

# PostgreSQL 17 + pgvector.  The database container is only reachable inside
# the Compose network; port 5432 is never published to the host.
POSTGRES_DB=course_rag
POSTGRES_USER=course_rag
# Required by the production Compose stack.  Use a strong, random password.
# The password inside DATABASE_URL below must match this value.
POSTGRES_PASSWORD=

# Required by the production Compose stack.
# The password in this URL must be identical to POSTGRES_PASSWORD.  If the
# password contains URL special characters (@ : / ? # % etc.), URL-encode
# them in this connection string (e.g. %40 for @, %3A for :, %25 for %).
DATABASE_URL=

# LLM configuration.  All three are required by the production Compose stack
# because the answer-generation service cannot start without them.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# RAG
RAG_MIN_RELEVANCE_SCORE=0.35
MAX_UPLOAD_BYTES=10485760

# Optional Reranker，默认关闭。Production 保持关闭时资源占用更低。
RAG_RERANKER_ENABLED=false
RAG_RERANKER_MODEL=
RAG_RERANKER_CANDIDATE_TOP_K=15

# Storage backend.
# Documentation only: production Compose always pins pgvector via
# compose.pgvector.yaml + compose.prod.yaml.  The production stack never
# falls back to the memory backend.  Do not set this to memory in production.
VECTOR_STORE_BACKEND=pgvector
